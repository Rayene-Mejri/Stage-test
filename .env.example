# Copy this file to .env and replace all values before running Docker Compose.
MYSQL_DATABASE=stage_test
MYSQL_USER=stage_user
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
APP_PORT=8081

# Required only when Google sign-in is enabled.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
